# Keep each asset below MSVC C2026's single-literal limit.
file(WRITE "${OUT_HEADER}" "// generated by cmake/embed_webui.cmake\n#pragma once\n#include <string>\nnamespace breeze_webui {\n")
function(embed_asset name path)
    file(READ "${path}" content)
    string(LENGTH "${content}" length)
    file(APPEND "${OUT_HEADER}" "inline const std::string ${name} = std::string()")
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${content}" ${offset} 8000 piece)
        file(APPEND "${OUT_HEADER}" "\n+ R\"BREEZE_RAW(${piece})BREEZE_RAW\"")
        math(EXPR offset "${offset} + 8000")
    endwhile()
    file(APPEND "${OUT_HEADER}" ";\n")
endfunction()
embed_asset(index_html "${WEBUI_DIR}/index.html")
embed_asset(style_css "${WEBUI_DIR}/style.css")
embed_asset(app_js "${WEBUI_DIR}/app.js")
file(APPEND "${OUT_HEADER}" "}\n")
